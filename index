function renderGantt(){let date=document.getElementById('gantt-start').value||'2026-10-30';let dt=new Date(date+'T12:00:00Z');if(isNaN(dt.getTime()))return;document.getElementById('gantt-head').innerHTML='<div>任务 / Task</div>'+Array.from({length:6},(_,i)=>`<div>W${i+1}<span style="display:block;font-size:10px;margin-top:3px;font-weight:500">${fmt(addDays(dt,i*7))}–${fmt(addDays(dt,i*7+6))}</span></div>`).join('');let owner=document.getElementById('owner-filter').value;document.getElementById('gantt-body').innerHTML=tasks.filter(t=>owner==='all'||t.owner===owner).map(t=>`<div class="gantt-row"><div class="task-name" title="${t.deliver}"><b>${t.name}</b><span>${t.en}</span></div>${Array.from({length:6},(_,i)=>i+1===t.s?`<div style="grid-column:${i+2}/span ${t.e-t.s+1}"><div class="gantt-bar ${t.owner}" title="${t.deliver}">${t.owner==='a'?'A':t.owner==='b'?'B':'A + B'} · ${t.deliver}</div></div>`:(i+1<t.s||i+1>t.e?`<div class="gantt-track"></div>`:'')).join('')}</div>`).join('')}
