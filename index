let saved=[];try{saved=JSON.parse(localStorage.getItem('ee641-checks')||'[]')}catch(_){}function updateCheckUI(){let all=document.querySelectorAll('#kickoff-checks input[type=checkbox]');let n=[...all].filter(x=>x.checked).length;document.getElementById('check-progress').style.width=(n/all.length*100)+'%';document.getElementById('check-count').textContent=n+' / '+all.length+' decisions confirmed';try{localStorage.setItem('ee641-checks',JSON.stringify([...all].map((x,i)=>x.checked?i:null).filter(x=>x!==null)))}catch(_){}}
document.getElementById('kickoff-checks').innerHTML=checks.map((c,i)=>`<label class="checkitem"><input type="checkbox" data-i="${i}" ${saved.includes(i)?'checked':''} onchange="updateCheckUI()"><span>${c[0]}<span class="en">${c[1]}</span></span></label>`).join('');
function copyMinutes(){let checked=[...document.querySelectorAll('#kickoff-checks input')].map((x,i)=>`${x.checked?'[x]':'[ ]'} ${checks[i][0]} / ${checks[i][1]}`).join('\n');let txt=`EE 641 | Kickoff Meeting Notes\nDate: __________\nParticipants: Member A / Member B\nSelected topic: __________\nResearch question: __________\nHypothesis: __________\nBaseline: __________\nDataset + license: __________\nPrimary metrics: __________\nGPU/compute budget: __________\nDecision log:\n${checked}\n\nACTION ITEMS (next 48h)\nMember A: __________  Due: __________\nMember B: __________  Due: __________\nNext check-in: __________\nOfficial deliverables/deadlines (verify Canvas): __________`; if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(txt).then(()=>showToast('已复制 / Copied')).catch(()=>fallbackCopy(txt))}else fallbackCopy(txt)}function fallbackCopy(txt){let a=document.createElement('textarea');a.value=txt;document.body.appendChild(a);a.select();document.execCommand('copy');a.remove();showToast('已复制 / Copied')};let toastEl=null;function showToast(msg){if(toastEl)toastEl.remove();toastEl=document.createElement('div');toastEl.textContent=msg;toastEl.style.cssText='position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#1d1d1f;color:white;padding:12px 20px;border-radius:999px;font:600 13px -apple-system,sans-serif;z-index:200;box-shadow:0 10px 30px #0002';document.body.appendChild(toastEl);setTimeout(()=>{if(toastEl){toastEl.remove();toastEl=null}},2400)}
